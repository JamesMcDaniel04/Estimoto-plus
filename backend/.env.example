# Required. Use a dedicated database; run Alembic before starting.
DATABASE_URL=sqlite:////absolute/path/outside/repository/estimoto-plus.sqlite
ENVIRONMENT=development
PHOTO_DIR=/absolute/path/outside/repository/estimoto-plus-photos
# Exact web preview origins, comma separated. Empty disables browser cross-origin access.
CORS_ORIGINS=

# Optional representative vehicle images. Reuse the existing original CarsXE
# account only on the server; never include this key in Flutter/web builds.
CARSXE_API_KEY=

# Required for real customer sessions. Leave empty for isolated demo only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional, server only: lets account deletion remove the Supabase Auth user.
SUPABASE_SERVICE_ROLE_KEY=

# Required for live service requests and trusted inbound bridge routes.
BRIDGE_REQUEST_URL=
BRIDGE_KEY=

# Explicit local demo gate. Never enable in production.
DEV_SESSIONS_ENABLED=false
DEV_TOKEN_SECRET=
PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
PLACES_DAILY_REQUESTS=100
